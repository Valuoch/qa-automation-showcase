{
  "name": "qa-automation-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Web UI, API contract and load-test automation with Playwright, TypeScript and k6, run in GitHub Actions.",
  "author": "Valentine Komulo",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:web": "playwright test --project=web-chromium --project=web-firefox",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "load:smoke": "k6 run load/smoke.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.2"
  }
}
